{
  "expo": {
    "name": "Аудиогид Петергоф",
    "slug": "peterhof-audioguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.s_smk17.peterhofaudioguide"
    },
    "web": {
      "name": "Аудиогид Петергоф",
      "shortName": "Петергоф",
      "description": "Аудиогид по маршруту автобуса 343Э: Ломоносов — Петергоф — метро «Проспект Ветеранов»",
      "lang": "ru",
      "themeColor": "#0B1217",
      "backgroundColor": "#0B1217",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна, чтобы автоматически открывать ближайшие точки маршрута.",
          "locationAlwaysAndWhenInUsePermission": "Разрешите геолокацию «Всегда», чтобы аудиогид рассказывал о точках маршрута, даже когда телефон в кармане.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "Разрешите геолокацию «Всегда», чтобы аудиогид рассказывал о точках маршрута, даже когда телефон в кармане."
        }
      ],
      "expo-image",
      "expo-asset",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "0765a625-13b1-4853-81c5-fa5239430c1b"
      }
    }
  }
}
